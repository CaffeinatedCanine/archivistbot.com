---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /** Folder inside src/assets, e.g. "works" */
  folder: string;
  /** Accessible label for the carousel region */
  label?: string;
}

const { folder, label = "Image carousel" } = Astro.props;

// import.meta.glob needs a static pattern, so glob everything under
// src/assets and filter by the folder prop. Only metadata is loaded here;
// Astro optimizes just the images actually rendered.
const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{png,jpg,jpeg,webp,avif,gif}",
  { eager: true },
);

const prefix = `/src/assets/${folder.replace(/^\/|\/$/g, "")}/`;

const slides = Object.entries(allImages)
  .filter(([path]) => path.startsWith(prefix))
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([path, mod]) => {
    const filename = path.split("/").pop()!.replace(/\.[^.]+$/, "");
    return {
      src: mod.default,
      // "works-embed_01" -> "works embed 01"
      alt: filename.replace(/[-_]+/g, " "),
    };
  });

const btn =
  "absolute top-1/2 -translate-y-1/2 z-10 grid size-10 place-items-center rounded-full " +
  "bg-AO3-light-card/90 text-AO3-black hover:bg-AO3-rose hover:text-AO3-white " +
  "dark:bg-AO3-wine/90 dark:text-AO3-silver dark:hover:bg-AO3-maroon " +
  "focus-visible:outline-2 focus-visible:outline-offset-2 " +
  "focus-visible:outline-AO3-teal dark:focus-visible:outline-AO3-cyan " +
  "disabled:opacity-30 disabled:pointer-events-none transition-colors cursor-pointer";
---

{
  slides.length > 0 && (
    <div
      class="not-content relative my-6"
      data-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label={label}
    >
      <ul
        data-track
        tabindex="0"
        class="flex list-none! m-0! p-0! overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-lg
               bg-AO3-gray dark:bg-AO3-wine scrollbar-none [&::-webkit-scrollbar]:hidden
               focus-visible:outline-2 focus-visible:outline-AO3-teal dark:focus-visible:outline-AO3-cyan"
      >
        {slides.map((slide, i) => (
          <li
            class="min-w-full snap-center flex items-center justify-center m-0! before:content-['']"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${slides.length}`}
          >
            <Image
  src={slide.src}
  alt={slide.alt}
  width={slide.src.width}
  height={slide.src.height}
  loading={i === 0 ? "eager" : "lazy"}
  style={`max-width: min(100%, ${slide.src.width}px);`}
  class="m-0! w-auto! h-auto! max-h-128 object-contain"
/>
          </li>
        ))}
      </ul>

      {slides.length > 1 && (
        <>
          <button type="button" data-prev aria-label="Previous image" class={`${btn} left-2`}>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <button type="button" data-next aria-label="Next image" class={`${btn} right-2`}>
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>

          <div class="mt-3 flex items-center justify-center gap-3">
            <div class="flex gap-2" data-dots>
              {slides.map((_, i) => (
                <button
                  type="button"
                  data-dot={i}
                  aria-label={`Go to image ${i + 1}`}
                  class="size-2.5 rounded-full cursor-pointer transition-colors
                         bg-AO3-light-card dark:bg-AO3-dark-card
                         aria-current:bg-AO3-magenta"
                />
              ))}
            </div>
            <span
              data-counter
              aria-live="polite"
              class="font-mono text-sm text-AO3-muted-light-text dark:text-AO3-muted-dark-text"
            >
              1 / {slides.length}
            </span>
          </div>
        </>
      )}
    </div>
  )
}

<script>
  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slides = Array.from(track.children) as HTMLElement[];
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    const counter = root.querySelector<HTMLElement>("[data-counter]");

    const current = () => Math.round(track.scrollLeft / track.clientWidth);

    const goTo = (i: number) => {
      const index = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: index * track.clientWidth });
    };

    const update = () => {
      const i = current();
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= slides.length - 1;
      dots.forEach((d, n) =>
        n === i ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current"),
      );
      if (counter) counter.textContent = `${i + 1} / ${slides.length}`;
    };

    prev?.addEventListener("click", () => goTo(current() - 1));
    next?.addEventListener("click", () => goTo(current() + 1));
    dots.forEach((d) => d.addEventListener("click", () => goTo(Number(d.dataset.dot))));

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); goTo(current() - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); goTo(current() + 1); }
    });

    track.addEventListener("scroll", () => requestAnimationFrame(update), { passive: true });
    update();
  }

  const setup = () =>
    document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((el) => {
      if (el.dataset.ready) return;
      el.dataset.ready = "true";
      initCarousel(el);
    });

  setup();
  // Re-run if you use Astro view transitions / ClientRouter
  document.addEventListener("astro:page-load", setup);
</script>